@model ExamSystem.DTOs.Grade.GradeRequestDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = (ViewBag.FormTitle ?? "Create") + " Grade";
    ViewData["HeaderTitle"] = ViewBag.FormTitle ?? "Create Grade";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-xl-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="m-0 font-weight-bold"><i class="fas fa-layer-group mr-2 text-primary"></i>Grade Information</h6>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <div class="form-group col-md-8">
                        <label>Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Grade 10, IELTS" required maxlength="100" />
                    </div>
                    <div class="form-group col-md-4">
                        <label>Level / Category</label>
                        <input type="text" name="level" class="form-control" placeholder="Primary / Middle / High / Language" maxlength="100" />
                    </div>
                    <div class="form-group col-12">
                        <label>Description</label>
                        <textarea name="description" class="form-control" rows="3" maxlength="500" placeholder="Short description of this grade level..."></textarea>
                    </div>
                    <div class="form-group col-md-6">
                        <label>Display Sort Order</label>
                        <input type="number" name="sort_order" class="form-control" min="0" value="0" />
                        <small class="form-text text-muted">Lower numbers appear first in the list.</small>
                    </div>
                    <div class="form-group col-md-6 align-self-end pb-2">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" name="is_active" value="true" class="custom-control-input" id="isActive" checked />
                            <label class="custom-control-label" for="isActive"><strong>Active Status</strong> <small class="text-muted">(uncheck to disable this grade from selection)</small></label>
                        </div>
                    </div>
                    <div class="col-12 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save mr-1"></i>Save Grade</button>
                        <a href="/admin/grade/index" class="btn btn-outline-secondary px-4 ml-1">Cancel</a>
                        <div asp-validation-summary="All" class="text-danger mt-3"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
