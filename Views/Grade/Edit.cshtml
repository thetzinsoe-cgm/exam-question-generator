@model ExamSystem.DTOs.Grade.GradeResponseDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = (ViewBag.FormTitle ?? "Edit") + " Grade";
    ViewData["HeaderTitle"] = ViewBag.FormTitle ?? "Edit Grade";
    var listingPageUrl = Context.Request.Query["listingPageUrl"].FirstOrDefault() ?? "/admin/grade/index";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-xl-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold"><i class="fas fa-edit mr-2 text-primary"></i>Edit Grade</h6>
                <span class="badge badge-light border text-muted">ID: @Model.id</span>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" class="row g-3">
                    <input type="hidden" name="listingPageUrl" value="@listingPageUrl" />
                    <div class="form-group col-md-8">
                        <label>Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" required maxlength="100" value="@Model.name" />
                    </div>
                    <div class="form-group col-md-4">
                        <label>Level / Category</label>
                        <input type="text" name="level" class="form-control" maxlength="100" value="@Model.level" />
                    </div>
                    <div class="form-group col-12">
                        <label>Description</label>
                        <textarea name="description" class="form-control" rows="3" maxlength="500">@Model.description</textarea>
                    </div>
                    <div class="form-group col-md-6">
                        <label>Display Sort Order</label>
                        <input type="number" name="sort_order" class="form-control" min="0" value="@Model.sort_order" />
                        <small class="form-text text-muted">Lower numbers appear first in the list.</small>
                    </div>
                    <div class="form-group col-md-6 align-self-end pb-2">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" name="is_active" value="true" class="custom-control-input" id="isActive" @(Model.is_active ? "checked" : "") />
                            <label class="custom-control-label" for="isActive"><strong>Active Status</strong> <small class="text-muted">(uncheck to disable)</small></label>
                        </div>
                    </div>
                    <div class="col-12 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save mr-1"></i>Update Grade</button>
                        <a href="@listingPageUrl" class="btn btn-outline-secondary px-4 ml-1">Cancel</a>
                        <div asp-validation-summary="All" class="text-danger mt-3"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
