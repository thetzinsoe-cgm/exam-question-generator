@using ExamSystem.ViewModels.Exam
@model ExamIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Exams";
    ViewData["HeaderTitle"] = "Exams";
}
@section Toolbar {
    <a href="/admin/exam/generate" class="btn btn-primary"><i class="fas fa-magic mr-1"></i>Generate New Exam</a>
}
<div class="card">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row mb-3 align-items-end">
            <div class="col-md-3 mb-2">
                <label for="examSearch" class="sr-only">Search exams</label>
                <input type="text" id="examSearch" name="search" value="@Model.Filter.search" class="form-control" placeholder="Search title or code..." />
            </div>
            <div class="col-md-2 mb-2">
                <label for="gradeFilter" class="sr-only">Filter by grade</label>
                @{
                    var grades = ViewBag.Grades as System.Collections.IEnumerable ?? new object[0];
                }
                <select name="grade_id" id="gradeFilter" class="form-control">
                    <option value="" selected="@(Model.Filter.grade_id == null)">All Grades</option>
                    @foreach (var g in System.Linq.Enumerable.Cast<dynamic>(grades))
                    {
                        <option value="@g.id" selected="@(Model.Filter.grade_id == g.id)">@g.name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 mb-2">
                <label for="subjectFilter" class="sr-only">Filter by subject</label>
                <select name="subject_id" id="subjectFilter" class="form-control">
                    <option value="" selected="@(Model.Filter.subject_id == null)">All Subjects</option>
                    @{
                        var subjects = ViewBag.Subjects as System.Collections.IEnumerable;
                        if (subjects != null)
                        {
                            foreach (var s in System.Linq.Enumerable.Cast<dynamic>(subjects))
                            {
                                <option value="@s.id" selected="@(Model.Filter.subject_id == s.id)">@s.name</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-1 mb-2">
                <label for="pageSize" class="sr-only">Page size</label>
                @Html.DropDownList("page_size", Model.PageSizeOptions, new { @class = "form-control", id = "pageSize", onchange = "$(this).closest('form').submit()" })
            </div>
            <div class="col-md-2 mb-2 text-right">
                <button class="btn btn-primary" type="submit" aria-label="Search"><i class="fas fa-search"></i></button>
                <a href="/admin/exam/index" class="btn btn-outline-secondary" aria-label="Reset filters"><i class="fas fa-redo"></i></a>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Exam Code</th><th>Title</th><th>Grade</th><th>Subject</th>
                    <th class="text-right">Count</th><th class="text-right">Duration</th><th class="text-right">Total Marks</th>
                    <th class="text-center" style="width:170px">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Response.Data != null && Model.Response.Data.Any())
                {
                    foreach (var e in Model.Response.Data)
                    {
                        <tr>
                            <td class="text-nowrap"><code>@e.exam_code</code></td>
                            <td>@e.title</td>
                            <td class="text-nowrap">@e.grade_name</td><td>@e.subject_name</td>
                            <td class="text-right"><span class="badge badge-info">@e.total_questions</span></td>
                            <td class="text-right text-nowrap">@e.duration_minutes <small class="text-muted">min</small></td>
                            <td class="text-right font-weight-bold text-nowrap">@e.total_marks.ToString("0.##")</td>
                            <td class="text-center">
                                <a href="/admin/exam/edit/@e.id?listingPageUrl=@Context.Request.Path@Context.Request.QueryString" class="btn btn-sm btn-outline-primary" aria-label="Edit exam @e.exam_code" title="Edit"><i class="fas fa-edit" aria-hidden="true"></i></a>
                                <a href="/admin/exam/preview/@e.id" class="btn btn-sm btn-outline-info" aria-label="Preview exam @e.exam_code" title="Preview"><i class="fas fa-eye" aria-hidden="true"></i></a>
                                <a href="/admin/exam/export-pdf/@e.id" target="_blank" class="btn btn-sm btn-outline-success" aria-label="Export PDF for @e.exam_code" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i></a>
                                <a href="/admin/exam/delete/@e.id?page_number=@(Model.Filter.page_number)" class="btn btn-sm btn-outline-danger" aria-label="Delete exam @e.exam_code" title="Delete" data-confirm="Delete exam @e.exam_code? This cannot be undone." onclick="return inlineConfirm(this, event)"><i class="fas fa-trash" aria-hidden="true"></i></a>
                            </td>
                        </tr>
                    }
                }
                else {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">
                            <i class="fas fa-inbox fa-3x mb-3 d-block text-muted"></i>
                            <p class="mb-2 font-weight-bold">No exams found</p>
                            <p class="mb-3 small">Try adjusting your filters or generate a new exam.</p>
                            <a href="/admin/exam/generate" class="btn btn-sm btn-primary"><i class="fas fa-plus mr-1"></i>Generate New Exam</a>
                        </td>
                    </tr>
                }
            </tbody>
            </table>
        </div>
        @Html.Partial("_PaginationPartial")
    </div>
</div>
@section Scripts {
<script>
    $(function () {
        $('#gradeFilter').change(function () {
            var gid = $(this).val();
            $.getJSON('/admin/question/subjects-by-grade?grade_id=' + gid, function (data) {
                var list = data.data || data || [];
                var sel = $('#subjectFilter').empty().append('<option value="">All Subjects</option>');
                list.forEach(function (s) { sel.append($('<option>', { value: s.id, text: s.name })); });
            }).fail(function () { console.error('Failed to load subjects by grade.'); });
        });
    });

    function inlineConfirm(el, ev) {
        if (el.dataset.armed === '1') { return true; }
        ev.preventDefault();
        var cancel = el.parentNode.querySelector('.cancel-delete');
        if (cancel) { cancel.remove(); el.dataset.armed = ''; el.className = 'btn btn-sm btn-outline-danger'; el.innerHTML = '<i class="fas fa-trash" aria-hidden="true"></i>'; return false; }
        var original = el.innerHTML;
        el.dataset.armed = '1';
        el.className = 'btn btn-sm btn-warning';
        el.innerHTML = '<i class="fas fa-check" aria-hidden="true"></i>';
        var c = document.createElement('a');
        c.href = '#'; c.className = 'btn btn-sm btn-outline-secondary cancel-delete ml-1';
        c.innerHTML = '<i class="fas fa-times" aria-hidden="true"></i>';
        c.setAttribute('aria-label', 'Cancel delete');
        el.parentNode.insertBefore(c, el.nextSibling);
        c.addEventListener('click', function (e) {
            e.preventDefault();
            el.dataset.armed = ''; el.className = 'btn btn-sm btn-outline-danger'; el.innerHTML = original;
            c.remove();
        });
        setTimeout(function () {
            if (el.dataset.armed === '1') { el.dataset.armed = ''; el.className = 'btn btn-sm btn-outline-danger'; el.innerHTML = original; if (c.parentNode) c.remove(); }
        }, 4000);
        return false;
    }
</script>
}
