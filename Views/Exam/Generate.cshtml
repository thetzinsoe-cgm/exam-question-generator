@model ExamSystem.DTOs.Exam.ManualExamGenerateRequestDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create New Exam";
    ViewData["HeaderTitle"] = "Create Exam (Manual Selection)";
    var grades = ViewBag.Grades as System.Collections.IEnumerable ?? new object[0];
    var qTypes = (ViewBag.QuestionTypes as System.Collections.IEnumerable ?? new object[0]).Cast<dynamic>();
}
<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-edit mr-2"></i>Build Exam Manually</h3>
                <div class="card-tools">
                    <span class="badge badge-pill badge-primary mr-2" id="globalQCount">0 questions</span>
                    <span class="badge badge-pill badge-success" id="globalMarks">0 marks</span>
                </div>
            </div>
            <div class="card-body">
                <div class="exam-paper-header">
                    <div class="paper-line">
                        <span class="paper-label">Exam Year</span>
                        <input type="text" id="exam_year" class="form-control paper-year text-center" maxlength="50" placeholder="၂၀၂၆ ခုနှစ် / 2026" />
                    </div>
                    <div class="paper-line">
                        <span class="paper-label">Exam Name</span>
                        <input type="text" id="title" class="form-control paper-title text-center" maxlength="255" required placeholder="တက္ကသိုလ်ဝင်စာမေးပွဲ / Matriculation Examination" />
                    </div>
                    <div class="paper-line">
                        <span class="paper-label">Examination Center</span>
                        <input type="text" id="examination_center" class="form-control paper-center text-center" maxlength="255" placeholder="မြန်မာနိုင်ငံစာစစ်ဦးစီးဌာန / Examination Directorate" />
                    </div>
                    <div class="paper-meta-row">
                        <div class="form-group mb-0">
                            <label for="subject_id">Subject <span class="text-danger">*</span></label>
                            <select id="subject_id" class="form-control" required>
                                <option value="">-- Subject --</option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label for="duration_minutes">Allowed Time (min)</label>
                            <input type="number" id="duration_minutes" min="1" class="form-control" value="120" />
                        </div>
                    </div>
                    <div class="paper-line">
                        <span class="paper-label">Description / Instructions (optional)</span>
                        <textarea id="description" class="form-control paper-desc" rows="2" maxlength="1000">Write your name and ID clearly. Read each question carefully before answering.</textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center bg-light">
                <h5 class="mb-0"><i class="fas fa-layer-group mr-1 text-info"></i>Sections</h5>
                <button type="button" class="btn btn-sm btn-success" id="addSectionBtn"><i class="fas fa-plus mr-1"></i>Add Section</button>
            </div>
            <div class="card-body">
                <div class="row mb-3 px-1">
                    <div class="form-group col-md-6 mb-md-0">
                        <label for="grade_id">Grade <span class="text-danger">*</span></label>
                        <select id="grade_id" class="form-control" required>
                            <option value="">-- Grade --</option>
                            @foreach (var g in System.Linq.Enumerable.Cast<dynamic>(grades))
                            {
                                <option value="@g.id">@g.name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-6 mb-md-0">
                        <label for="pass_marks">Pass Marks</label>
                        <input type="number" id="pass_marks" step="0.01" min="0" class="form-control" />
                    </div>
                </div>
                <div id="sectionsContainer">
                    <div class="alert alert-warning mb-0"><i class="fas fa-exclamation-triangle mr-1"></i>No sections yet. Add a section, then pick questions from the question bank.</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
    <a href="/admin/exam/index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left mr-1"></i>Back to Exams</a>
    <button type="button" class="btn btn-primary btn-lg" id="generateBtn"><i class="fas fa-magic mr-1"></i>Generate Exam</button>
</div>
<div id="examFormMsg" class="mt-3 text-danger" role="alert" aria-live="assertive"></div>

@section HeadCss {
<style>
    .question-card { cursor: pointer; transition: border-color .15s ease; }
    .question-card.selected { border-color: #007bff !important; background: #eef4ff; }
    .q-bank-item { border: 1px solid #dee2e6; border-radius: .375rem; padding: .5rem .75rem; margin-bottom: .5rem; cursor: pointer; background:#fff; transition: box-shadow .15s ease; }
    .q-bank-item:hover { box-shadow: 0 1px 4px rgba(0,0,0,.12); }
    .q-bank-item.selected { border-color: #007bff; background:#f0f6ff; }
    .q-bank-item .q-text { font-size:.85rem; margin:0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .section-card { border:1px solid #dee2e6; border-radius:.5rem; margin-bottom:1rem; background:#f8f9fa; }
    .section-card .section-head { padding:.6rem 1rem; background:#e9ecef; border-bottom:1px solid #dee2e6; border-radius:.5rem .5rem 0 0; display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; }
    .section-card .section-body { padding:.75rem; min-height:60px; }
    .qs-sortable { min-height:40px; }
    .q-row { display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; background:#fff; border:1px solid #dee2e6; border-radius:.375rem; padding:.4rem .6rem; margin-bottom:.4rem; }
    .q-row .drag-handle { cursor:grab; color:#adb5bd; flex-shrink:0; }
    .q-row .q-num { font-weight:700; color:#007bff; width:28px; text-align:center; flex-shrink:0; }
    .q-row .q-info { flex:1 1 200px; min-width:0; }
    .q-row .q-marks-wrap { flex-shrink:0; }
    .q-row .removeQ { flex-shrink:0; }
    .q-row .q-info { flex:1; min-width:0; }
    .q-row .q-info .t { font-size:.82rem; margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .q-row .q-info .m { font-size:.7rem; color:#6c757d; }
    .q-row .marks-input { width:70px; }
    .q-row .q-num { font-weight:700; color:#007bff; width:28px; text-align:center; }
    .qs-sortable li.placeholder, .qs-sortable .sortable-ghost { opacity:.4; background:#dee2e6; }
    .drawer-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:1040; }
    .drawer-overlay.show { display:block; }
    .q-drawer { position:fixed; top:0; right:0; width:460px; max-width:92vw; height:100vh; background:#fff; z-index:1050; transform:translateX(100%); transition:transform .3s ease; box-shadow:-4px 0 16px rgba(0,0,0,.15); display:flex; flex-direction:column; }
    .q-drawer.open { transform:translateX(0); }
    .q-drawer .drawer-header { padding:.9rem 1rem; background:#343a40; color:#fff; display:flex; justify-content:space-between; align-items:center; }
    .q-drawer .drawer-body { flex:1; overflow-y:auto; padding:1rem; }
    .q-drawer .drawer-footer { padding:.75rem 1rem; border-top:1px solid #dee2e6; }
    .drawer-badge { font-size:.72rem; }
    .type-badge { font-size:.7rem; padding:.2em .55em; }
    .exam-paper-header { border:1px dashed #adb5bd; border-radius:.5rem; padding:1.25rem 1.5rem; background:#fffdf5; }
    .paper-line { margin-bottom: .75rem; }
    .paper-label { display:block; font-size:.72rem; text-transform:uppercase; letter-spacing:.03em; color:#6c757d; margin-bottom:.15rem; }
    .paper-year { font-size:1.15rem; font-weight:700; }
    .paper-title { font-size:1.35rem; font-weight:700; }
    .paper-center { font-size:1rem; font-weight:600; }
    .paper-line textarea.paper-desc, .paper-line .form-control { margin:0 auto; }
    .paper-meta-row { display:flex; flex-wrap:wrap; gap:.75rem 1rem; align-items:flex-start; justify-content:space-between; border-top:1px solid #e9ecef; border-bottom:1px solid #e9ecef; padding:.9rem 0; margin:.25rem 0 1rem; }
    .paper-meta-row .form-group { flex:1 1 170px; min-width:150px; }
</style>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
    var selState = {
        subject_id: null,
        grade_id: null,
        search: '',
        type: '',
        difficulty: ''
    };
    var selPage = 1;
    var selTotalPages = 0;
    var selectedQIds = {}; // question_id -> true
    var selectedBankMap = {}; // question_id -> {id,text,type,typeName,diff,diffName,marks,image}

    function qTypeName(v) {
        var m = {
            1:'MC',2:'T/F',3:'Short',4:'Essay',5:'Math',6:'BIO',7:'ECO',8:'Fill'
        };
        return m[v] || ('Type '+v);
    }
    function qTypeFullName(v) {
        var m = {
            1:'Multiple Choice',2:'True / False',3:'Short Answer',4:'Essay',5:'Math Expression',6:'BIO (with Image)',7:'ECO Calculation',8:'Fill in the Blank'
        };
        return m[v] || ('Type '+v);
    }
    function diffName(v){ return v==1?'Easy':v==3?'Hard':'Medium'; }
    function esc(s){ return $('<div>').text(s||'').html(); }

    // ---------- Section DOM ----------
    var sIdx = 0;
    function sectionTemplate(idx, name) {
        return `
        <div class="section-card" data-idx="${idx}">
            <div class="section-head" data-toggle="collapse" data-target="#secBody-${idx}" role="button" aria-expanded="true">
                <i class="fas fa-grip-vertical"></i>
                <input type="text" class="form-control form-control-sm sec-name" style="max-width:220px" value="${esc(name || ('Section ' + (idx+1)))}" onclick="event.stopPropagation()" />
                <span class="badge badge-secondary badge-pill sec-count-badge">0 Q</span>
                <span class="badge badge-info badge-pill sec-marks-badge">0 marks</span>
                <button type="button" class="btn btn-sm btn-outline-danger ml-auto removeSec" onclick="event.stopPropagation()"><i class="fas fa-trash"></i></button>
            </div>
            <div class="collapse show" id="secBody-${idx}">
                <div class="section-body">
                    <ul class="list-unstyled qs-sortable mb-2" data-sec-idx="${idx}"></ul>
                    <div class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-primary addQtoSec" data-sec-idx="${idx}"><i class="fas fa-plus mr-1"></i>Add Questions from Bank</button>
                    </div>
                </div>
            </div>
        </div>`;
    }
    function qRowTemplate(q, num) {
        return `
        <li class="q-row" data-qid="${q.id}">
            <span class="drag-handle" title="Drag to reorder"><i class="fas fa-grip-vertical"></i></span>
            <span class="q-num">${num}.</span>
            <div class="q-info">
                <p class="t" title="${esc(q.question_text)}">${esc(q.question_text)}</p>
                <span class="badge badge-secondary type-badge mr-1">${esc(qTypeName(q.question_type))}</span>
                <span class="badge badge-${q.difficulty==3?'danger':q.difficulty==1?'success':'warning'} type-badge mr-1">${esc(diffName(q.difficulty))}</span>
                <span class="text-muted small">${q.default_marks>0?q.default_marks+' pts default':''}</span>
            </div>
            <div class="q-marks-wrap input-group input-group-sm" style="width:110px; max-width:100%; flex-wrap:nowrap;">                <div class="input-group-preppend"><span class="input-group-text">+</span></div>
                <input type="number" step="0.01" min="0" class="form-control marks-input" value="${q.marks_allocated > 0 ? q.marks_allocated : (q.default_marks>0?q.default_marks:1)}" />
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger removeQ" title="Remove"><i class="fas fa-times"></i></button>
        </li>`;
    }
    function addSection(name) {
        name = name || ('Section ' + ('ABCDEFGH'[(sIdx) % 8] || (sIdx+1)));
        $('#sectionsContainer').find('.alert').remove();
        $('#sectionsContainer').append(sectionTemplate(sIdx, name));
        initSectionSortable(sIdx);
        sIdx++;
        updateSectionBadges();
    }
    function initSectionSortable(idx) {
        var el = $('.qs-sortable[data-sec-idx="'+idx+'"]')[0];
        if (!el) return;
        new Sortable(el, {
            group: { name: 'qs', pull: true, put: true },
            handle: '.drag-handle',
            animation: 150,
            ghostClass: 'sortable-ghost',
            onEnd: function () { renumberAll(); updateSectionBadges(); updateGlobal(); }
        });
    }

    // ---------- Section aggregation ----------
    function getSectionQData(secIdx) {
        var rows = $('.qs-sortable[data-sec-idx="'+secIdx+'"] .q-row');
        var list = [];
        rows.each(function () {
            var qid = parseInt($(this).data('qid'), 10);
            var marks = parseFloat($(this).find('.marks-input').val()) || 0;
            var src = selectedBankMap[qid] || {};
            list.push({ question_id: qid, marks_allocated: marks, question_text: src.question_text, question_type: src.question_type });
        });
        return list;
    }
    function renumberAll() {
        $('.section-card').each(function () {
            $(this).find('.q-row').each(function (i) {
                $(this).find('.q-num').text((i+1) + '.');
            });
        });
    }
    function updateSectionBadges() {
        $('.section-card').each(function () {
            var rows = $(this).find('.q-row');
            var count = rows.length;
            var marks = 0;
            rows.each(function () { marks += parseFloat($(this).find('.marks-input').val()) || 0; });
            $(this).find('.sec-count-badge').text(count + ' Q');
            $(this).find('.sec-marks-badge').text(marks + ' marks');
        });
    }
    function updateGlobal() {
        var totalQ = 0, totalMarks = 0;
        $('.section-card').each(function () {
            totalQ += $(this).find('.q-row').length;
            $(this).find('.q-row').each(function () { totalMarks += parseFloat($(this).find('.marks-input').val()) || 0; });
        });
        $('#globalQCount').text(totalQ + ' questions');
        $('#globalMarks').text(totalMarks + ' marks');
    }

    // ---------- Question Bank drawer ----------
    function openDrawer() {
        if (!$('#grade_id').val() || !$('#subject_id').val()) {
            $('#examFormMsg').text('Please select a Grade and Subject first.');
            return;
        }
        loadBank();
        $('#drawerOverlay').addClass('show');
        $('#qDrawer').addClass('open');
    }
    function closeDrawer() {
        $('#drawerOverlay').removeClass('show');
        $('#qDrawer').removeClass('open');
    }
    function loadBank() {
        var params = {
            subject_id: $('#subject_id').val(),
            grade_id: $('#grade_id').val(),
            search: selState.search,
            question_type: selState.type,
            difficulty: selState.difficulty,
            page_number: selPage,
            page_size: 20
        };
        $('#bankList').html('<div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin mr-1"></i>Loading...</div>');
        $('#bankSelCount').text('0 selected');
        $('#bankCheckAll').prop('checked', false);
        $.getJSON('/admin/question/search', params, function (res) {
            var d = res.data || {};
            var items = d.questions || [];
            selTotalPages = d.total_pages || 0;
            if (!items.length) {
                $('#bankList').html('<div class="text-center text-muted py-4">No questions found.</div>');
            } else {
                var html = items.map(function (q) {
                    var isSel = !!selectedQIds[q.id];
                    return `
                    <div class="q-bank-item ${isSel?'selected':''}" data-qid="${q.id}" data-json='${esc(JSON.stringify({id:q.id,question_text:q.question_text,question_type:q.question_type,question_type_name:q.question_type_name,difficulty:q.difficulty,difficulty_name:q.difficulty_name,default_marks:q.default_marks,image_url:q.image_url}))}'>
                        <p class="q-text">${esc(q.question_text)}</p>
                        <div>
                            <span class="badge badge-secondary type-badge mr-1">${esc(qTypeName(q.question_type))}</span>
                            <span class="badge badge-${q.difficulty==3?'danger':q.difficulty==1?'success':'warning'} type-badge mr-1">${esc(diffName(q.difficulty))}</span>
                            <span class="badge badge-light type-badge">${q.default_marks>0?q.default_marks+' pts':'-'}</span>
                        </div>
                    </div>`;
                }).join('');
                $('#bankList').html(html);
            }
            $('#bankTotal').text('(' + (d.total||0) + ' found)');
            // pagination
            var pageTxt = 'Page ' + selPage + ' / ' + (selTotalPages||1);
            $('#bankPageLeft').prop('disabled', selPage<=1);
            $('#bankPageRight').prop('disabled', selPage>=selTotalPages);
            $('#bankPageInfo').text(pageTxt);
        }).fail(function () {
            $('#bankList').html('<div class="text-center text-danger py-4">Failed to load questions.</div>');
        });
    }

    // ---------- Add selected to section ----------
    function addSelectedToSection(secIdx) {
        var picked = [];
        $('#bankList .q-bank-item.selected').each(function () {
            var qid = parseInt($(this).data('qid'), 10);
            var json = $(this).attr('data-json');
            try { picked.push(JSON.parse(json)); } catch (e) { }
        });
        if (!picked.length) { alert('Select at least one question in the bank first.'); return; }

        var secEl = $('.qs-sortable[data-sec-idx="'+secIdx+'"]');
        var existing = {};
        secEl.find('.q-row').each(function(){ existing[$(this).data('qid')] = true; });
        var added = 0;
        picked.forEach(function (q) {
            if (existing[q.id]) return;
            selectedQIds[q.id] = true;
            selectedBankMap[q.id] = q;
            secEl.append(qRowTemplate(q, secEl.find('.q-row').length + 1));
            added++;
        });
        $('#bankList .q-bank-item.selected').removeClass('selected').prop('checked', false);
        if (added) { renumberAll(); updateSectionBadges(); updateGlobal(); }
    }

    function openDrawerForSection(secIdx) {
        window._targetSecIdx = secIdx;
        openDrawer();
    }

    $(function () {
        $('#grade_id').change(function () {
            var gid = $(this).val();
            $('#subject_id').empty().append('<option value="">-- Subject --');
            if (!gid) return;
            $.getJSON('/admin/question/subjects-by-grade?grade_id=' + gid, function (data) {
                var list = data.data || data || [];
                list.forEach(function (s) { $('#subject_id').append($('<option>', { value: s.id, text: s.name })); });
            });
        });

        $('#addSectionBtn').on('click', function () { addSection(); });
        $(document).on('click', '.removeSec', function () { $(this).closest('.section-card').remove(); updateGlobal(); });
        $(document).on('click', '.removeQ', function () {
            var row = $(this).closest('.q-row');
            var qid = parseInt(row.data('qid'),10);
            delete selectedQIds[qid];
            row.remove();
            renumberAll(); updateSectionBadges(); updateGlobal();
        });
        $(document).on('input blur', '.marks-input', function () { updateSectionBadges(); updateGlobal(); });
        $(document).on('click', '.addQtoSec', function () { openDrawerForSection(parseInt($(this).data('sec-idx'),10)); });

        // Bank drawer interactions
        $('#closeDrawer').on('click', closeDrawer);
        $('#drawerOverlay').on('click', closeDrawer);
        $('#bankSearch').on('keydown', function (e) { if (e.key === 'Enter') { selState.search = this.value; selPage=1; loadBank(); } });
        $('#bankSearchBtn').on('click', function () { selState.search = $('#bankSearch').val(); selPage=1; loadBank(); });
        $('#bankType').on('change', function () { selState.type = this.value; selPage=1; loadBank(); });
        $('#bankDiff').on('change', function () { selState.difficulty = this.value; selPage=1; loadBank(); });
        $('#bankPageLeft').on('click', function () { if (selPage>1){ selPage--; loadBank(); } });
        $('#bankPageRight').on('click', function () { if (selPage<selTotalPages){ selPage++; loadBank(); } });
        $('#bankCheckAll').on('change', function () {
            $('#bankList .q-bank-item').toggleClass('selected', this.checked);
            updateBankSelCount();
        });
        $('#bankList').on('click', '.q-bank-item', function () {
            $(this).toggleClass('selected');
            updateBankSelCount();
        });
        function updateBankSelCount() {
            var n = $('#bankList .q-bank-item.selected').length;
            $('#bankSelCount').text(n + ' selected');
            var anyOnPage = $('#bankList .q-bank-item').length > 0;
            var allSel = $('#bankList .q-bank-item.selected').length === $('#bankList .q-bank-item').length && anyOnPage;
            $('#bankCheckAll').prop('checked', allSel);
        }
        $('#bankAddSelected').on('click', function () {
            var secIdx = window._targetSecIdx != null ? window._targetSecIdx : ($('.section-card').length ? 0 : -1);
            if (secIdx < 0) { alert('Please add a section first.'); return; }
            addSelectedToSection(secIdx);
        });

        // Generate
        $('#generateBtn').on('click', function () {
            $('#examFormMsg').text('');
            var title = $('#title').val().trim();
            var grade_id = $('#grade_id').val();
            var subject_id = $('#subject_id').val();
            if (!title) { $('#examFormMsg').text('Please enter a title.'); return; }
            if (!grade_id || !subject_id) { $('#examFormMsg').text('Please select Grade and Subject.'); return; }

            var sections = [];
            var hasQ = false;
            $('#sectionsContainer .section-card').each(function () {
                var secName = $(this).find('.sec-name').val().trim() || ('Section ' + ($(this).index()+1));
                var qs = [];
                $(this).find('.q-row').each(function (i) {
                    var qid = parseInt($(this).data('qid'),10);
                    var marks = parseFloat($(this).find('.marks-input').val()) || 0;
                    qs.push({ question_id: qid, question_number: i+1, marks_allocated: marks, section_name: secName });
                    hasQ = true;
                });
                sections.push({ section_name: secName, questions: qs });
            });
            if (!sections.length || !hasQ) { $('#examFormMsg').text('Add at least one question to a section.'); return; }

            var payload = {
                title: title,
                description: $('#description').val(),
                exam_year: $('#exam_year').val(),
                examination_center: $('#examination_center').val(),
                subject_id: parseInt(subject_id,10),
                grade_id: parseInt(grade_id,10),
                duration_minutes: parseInt($('#duration_minutes').val()) || 120,
                pass_marks: parseFloat($('#pass_marks').val()) || 0,
                sections: sections
            };
            var btn = $(this);
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Generating...');
            $.ajax({
                url: '/admin/exam/generate-manual',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success && res.redirect) { window.location.href = res.redirect; }
                    else { btn.prop('disabled', false).html('<i class="fas fa-magic mr-1"></i>Generate Exam'); $('#examFormMsg').text(res.error || 'Failed to generate exam.'); }
                },
                error: function (xhr) {
                    btn.prop('disabled', false).html('<i class="fas fa-magic mr-1"></i>Generate Exam');
                    var msg = 'Server error. Please try again.';
                    if (xhr.responseJSON && xhr.responseJSON.error) msg = xhr.responseJSON.error;
                    $('#examFormMsg').text(msg);
                }
            });
        });

        // default: add one section
        addSection('Section A');
    });

    // expose for inline onclick
    window.addSection = addSection;
    window.closeDrawer = closeDrawer;
</script>
}

<!-- Drawer markup -->
<div class="drawer-overlay" id="drawerOverlay"></div>
<div class="q-drawer" id="qDrawer" aria-label="Question bank">
    <div class="drawer-header">
        <h6 class="mb-0"><i class="fas fa-question-circle mr-1"></i>Question Bank</h6>
        <button type="button" class="close text-white" id="closeDrawer" aria-label="Close"><span aria-hidden="true">&times;</span></button>
    </div>
    <div class="drawer-body">
        <div class="row mb-2">
            <div class="col-8">
                <input type="text" id="bankSearch" class="form-control form-control-sm" placeholder="Search questions..." />
            </div>
            <div class="col-4">
                <button type="button" class="btn btn-sm btn-outline-primary btn-block" id="bankSearchBtn"><i class="fas fa-search"></i></button>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-6">
                <select id="bankType" class="form-control form-control-sm">
                    <option value="">All Types</option>
                    @foreach (var t in qTypes)
                    {
                        <option value="@t.id">@t.name</option>
                    }
                </select>
            </div>
            <div class="col-6">
                <select id="bankDiff" class="form-control form-control-sm">
                    <option value="">All Difficulty</option>
                    <option value="1">Easy</option>
                    <option value="2">Medium</option>
                    <option value="3">Hard</option>
                </select>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="mb-0 small"><input type="checkbox" id="bankCheckAll" /> Select all on page</label>
            <span class="small text-muted" id="bankTotal"></span>
        </div>
        <div id="bankList"></div>
        <div class="d-flex justify-content-center align-items-center mt-3">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="bankPageLeft"><i class="fas fa-chevron-left"></i></button>
            <span class="mx-3" id="bankPageInfo"></span>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="bankPageRight"><i class="fas fa-chevron-right"></i></button>
        </div>
    </div>
    <div class="drawer-footer d-flex align-items-center">
        <span class="mr-auto text-muted small" id="bankSelCount">0 selected</span>
        <button type="button" class="btn btn-primary btn-sm" id="bankAddSelected"><i class="fas fa-plus mr-1"></i>Add to Section</button>
    </div>
</div>
