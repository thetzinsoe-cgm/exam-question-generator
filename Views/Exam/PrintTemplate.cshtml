@model ExamSystem.DTOs.Exam.ExamResponseDto
@using System.Collections.Generic
@using System.Linq
@using System.Text
@using System.Web
@using Newtonsoft.Json
@{
    Layout = null;

    string MmDigit(int n)
    {
        var s = n.ToString();
        return s.Replace("0","၀").Replace("1","၁").Replace("2","၂").Replace("3","၃").Replace("4","၄")
                .Replace("5","၅").Replace("6","၆").Replace("7","၇").Replace("8","၈").Replace("9","၉");
    }
    string MmAlphaUpper(int i)
    {
        char[] arr = { 'က','ခ','ဂ','ဃ','င','စ','ဆ','ဇ','ဈ','ည','ဋ','ဌ','ဍ','ဎ','ဏ','တ','ထ','ဒ','ဓ','န','ပ','ဖ','ဗ','ဘ','မ','ယ','ရ','လ','ဝ','သ','ဟ','ဠ','အ' };
        return i >= 1 && i <= arr.Length ? arr[i - 1].ToString() : i.ToString();
    }
    const short ECO_TYPE_ID = 7;
    int toHours(int minutes) => minutes > 0 ? (int)Math.Round(minutes / 60.0) : 0;

    var questionsOrdered = (Model.questions ?? new List<ExamSystem.DTOs.Exam.ExamQuestionDto>())
        .OrderBy(q => q.question_number).ToList();
    var groupedBySection = new Dictionary<string, List<ExamSystem.DTOs.Exam.ExamQuestionDto>>();
    foreach (var q in questionsOrdered)
    {
        var s = string.IsNullOrWhiteSpace(q.section_name) ? "ပုဒ်မခွဲ (၁)" : q.section_name;
        if (!groupedBySection.ContainsKey(s)) groupedBySection[s] = new List<ExamSystem.DTOs.Exam.ExamQuestionDto>();
        groupedBySection[s].Add(q);
    }

    var sb = new StringBuilder();

    // ---- Board header (sample style) ----
    sb.Append("<div class=\"board\">");
    sb.Append("<div class=\"line1\">၂၀၂၆ ခုနှစ်</div>");
    sb.Append("<div class=\"line2\">တက္ကသိုလ်ဝင်စာမေးပွဲ</div>");
    sb.Append("<div class=\"line2\">မြန်မာနိုင်ငံစာစစ်ဦးစီးဌာန</div>");
    sb.Append("<div class=\"subject-row\">");
    var subjName = string.IsNullOrWhiteSpace(Model.title) ? Model.subject_name : Model.title;
    sb.Append("<span class=\"time\">ခွင့်ပြုချိန် " + (Model.duration_minutes > 0 ? MmDigit(toHours(Model.duration_minutes)) + " နာရီ" : "………… နာရီ") + "</span>");
    sb.Append("<span class=\"subject\">" + System.Web.HttpUtility.HtmlEncode(subjName) + "</span>");
    sb.Append("<div class=\"clearfix\"></div></div>");
    sb.Append("<div class=\"instruction\">မေးခွန်းအားလုံးဖြေဆိုပါ။</div>");
    sb.Append("</div>");

    // ---- Sections ----
    int sectionIndex = 0;
    foreach (var section in groupedBySection)
    {
        sectionIndex++;
        var secMarks = section.Value.Sum(q => Math.Max(0, q.marks_allocated));
        var digitSec = section.Key.StartsWith("၁။");
        var tableSec = section.Key.StartsWith("၂။");

        sb.Append("<div class=\"section-title\">");
        sb.Append("<span class=\"sec-mark\">(" + MmDigit((int)Math.Max(secMarks, 0)) + ") မှတ်</span>");
        sb.Append("<span class=\"sec-name\">" + System.Web.HttpUtility.HtmlEncode(section.Key) + "</span>");
        sb.Append("<div class=\"clearfix\"></div>");
        sb.Append("</div>");

        int idx = 0;
        foreach (var q in section.Value)
        {
            idx++;
            var isECO = q.question_type == ECO_TYPE_ID;
            var qBodyHtml = string.IsNullOrWhiteSpace(q.question_html) ? q.question_text : q.question_html;
            string label;
            if (tableSec) { label = ""; }
            else if (digitSec) { label = MmDigit(idx) + "။"; }
            else { label = "(" + MmAlphaUpper(idx) + ")"; }

            sb.Append("<table class=\"qhead\"><tr>");
            sb.Append("<td class=\"qnum\">" + System.Web.HttpUtility.HtmlEncode(label) + "</td>");
            sb.Append("<td class=\"qbody\">" + qBodyHtml);

            if (isECO && !string.IsNullOrWhiteSpace(q.eco_table_json))
            {
                try
                {
                    var tdRows = JsonConvert.DeserializeObject<List<List<string>>>(q.eco_table_json ?? "[]");
                    if (tdRows != null && tdRows.Any())
                    {
                        sb.Append("<table class=\"data\">");
                        int rowIdx = 0;
                        foreach (var r in tdRows)
                        {
                            rowIdx++;
                            string tag = rowIdx == 1 ? "th" : "td";
                            sb.Append("<tr>");
                            foreach (var c in r) sb.Append("<" + tag + ">" + System.Web.HttpUtility.HtmlEncode(c) + "</" + tag + ">");
                            sb.Append("</tr>");
                        }
                        sb.Append("</table>");
                    }
                }
                catch { }
            }

            if (isECO && !string.IsNullOrWhiteSpace(q.question_text) && q.question_html != q.question_text)
            {
                sb.Append("<div class=\"sub-items\">");
                foreach (var line in q.question_text.Split(new[] { "\n" }, StringSplitOptions.RemoveEmptyEntries))
                    sb.Append("<div>" + line + "</div>");
                sb.Append("</div>");
            }

            sb.Append("</td></tr></table>");
        }

        if (sectionIndex == 1 || sectionIndex == 5)
        {
            sb.Append("<div class=\"footer-note\">[တစ်ဖက်သို့]</div>");
            sb.Append("<div class=\"page-break\"></div>");
        }
    }

    sb.Append("<div class=\"eop\">— အဆုံး —</div>");
    var bodyHtml = sb.ToString();
}
<!DOCTYPE html>
<html lang="my">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@(string.IsNullOrWhiteSpace(Model.exam_code) ? "စာမေးပွဲ" : Model.exam_code)</title>
    <style>
        @@page { size: A4 portrait; margin: 15mm 15mm 18mm 15mm; }
        * { box-sizing: border-box; }
        html, body {
            font-family: 'Pyidaungsu','Noto Sans Myanmar','Myanmar3','Padauk','WinResearcher','Arial Unicode MS','Segoe UI Historic',Tahoma,Arial,sans-serif;
            font-size: 11.5pt; color: #000; line-height: 1.35;
        }
        body { margin: 0; padding: 0; }
        .clearfix { clear: both; height: 0; line-height: 0; }
        .board { text-align: center; margin-bottom: 10pt; }
        .board .line1 { font-size: 12.5pt; font-weight: 700; margin: 1pt 0; }
        .board .line2 { font-size: 14pt; font-weight: 700; margin: 1pt 0; }
        .subject-row { margin: 10pt 0 4pt 0; font-size: 12pt; }
        .subject-row .time { float: right; font-weight: 700; }
        .subject-row .subject { font-weight: 700; }
        .board .instruction { font-weight: 700; text-align: center; margin: 6pt 0 0 0; }
        .section-title { font-size: 12.5pt; font-weight: 700; margin: 14pt 0 6pt 0; }
        .section-title .sec-mark { float: right; font-weight: 700; padding-left: 10pt; }
        table.qhead { width: 100%; border-collapse: collapse; margin: 0 0 8pt 0; }
        table.qhead td { border: none; padding: 0; vertical-align: top; }
        table.qhead td.qnum { width: 26pt; white-space: nowrap; font-weight: 700; padding-right: 4pt; }
        .qbody table.data, .qbody table.term { border-collapse: collapse; width: auto; margin: 5pt 0 4pt 0; font-size: 11pt; }
        .qbody table.data td, .qbody table.data th, .qbody table.term td, .qbody table.term th {
            border: 0.75pt solid #000; padding: 3pt 10pt; text-align: center; white-space: nowrap; font-weight: normal;
        }
        .qbody table.term td { text-align: left; }
        .sub-items { margin: 4pt 0 0 0; }
        .sub-items div { padding: 1pt 0; }
        .footer-note { text-align: right; margin: 12pt 0 0 0; font-weight: 700; }
        .page-break { page-break-after: always; }
        .eop { text-align: center; margin-top: 30pt; font-weight: 700; }
    </style>
</head>
<body>
    @Html.Raw(bodyHtml)
</body>
</html>
