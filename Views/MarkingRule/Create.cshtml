@model ExamSystem.DTOs.MarkingRule.MarkingRuleRequestDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = (ViewBag.FormTitle ?? "Create") + " Marking Rule";
    ViewData["HeaderTitle"] = ViewBag.FormTitle ?? "Create Marking Rule";
    var subjects = ViewBag.Subjects as System.Collections.IEnumerable ?? new object[0];
    var qTypes = ViewBag.QuestionTypes as System.Collections.IEnumerable ?? new object[0];
}
<div class="row justify-content-center">
    <div class="col-md-9 col-xl-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="m-0 font-weight-bold"><i class="fas fa-clipboard-check mr-2 text-primary"></i>Marking / Selection Rule</h6>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    <div class="form-group col-md-6">
                        <label>Subject <span class="text-danger">*</span></label>
                        <select name="subject_id" class="form-control" required>
                            <option value="">-- Select Subject --</option>
                            @foreach (var s in System.Linq.Enumerable.Cast<dynamic>(subjects))
                            {
                                <option value="@s.id">@s.name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label>Question Type <span class="text-danger">*</span></label>
                        <select name="question_type" class="form-control" required>
                            <option value="">-- Select Type --</option>
                            @foreach (var t in System.Linq.Enumerable.Cast<dynamic>(qTypes))
                            {
                                <option value="@t.id">@t.name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label>Rule Name</label>
                        <input type="text" name="rule_name" class="form-control" maxlength="100" placeholder="e.g. G10-Math-MCQ-Medium" />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Difficulty</label>
                        <select name="difficulty" class="form-control">
                            <option value="1">Easy</option>
                            <option value="2" selected>Medium</option>
                            <option value="3">Hard</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <hr class="my-2" />
                        <h6 class="text-muted small font-weight-bold text-uppercase mb-2"><i class="fas fa-coins mr-1"></i>Marks Configuration</h6>
                    </div>
                    <div class="form-group col-md-4">
                        <label>Marks per Question <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0" name="marks_per_question" value="1" class="form-control" required />
                    </div>
                    <div class="form-group col-md-4">
                        <label>Negative Marks (wrong answer)</label>
                        <input type="number" step="0.01" min="0" name="negative_marks" value="0" class="form-control" />
                        <small class="form-text text-muted">0 = no penalty</small>
                    </div>
                    <div class="col-12 mt-3">
                        <hr class="my-2" />
                        <h6 class="text-muted small font-weight-bold text-uppercase mb-2"><i class="fas fa-list-ol mr-1"></i>Question Pool Size (per exam paper)</h6>
                    </div>
                    <div class="form-group col-md-4">
                        <label>Min Questions</label>
                        <input type="number" min="0" name="min_questions" value="0" class="form-control" />
                    </div>
                    <div class="form-group col-md-4">
                        <label>Max Questions</label>
                        <input type="number" min="0" name="max_questions" value="0" class="form-control" />
                    </div>
                    <div class="form-group col-md-4 align-self-end pb-2">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" name="is_active" value="true" class="custom-control-input" id="isActive" checked />
                            <label class="custom-control-label" for="isActive"><strong>Active Status</strong></label>
                        </div>
                    </div>
                    <div class="form-group col-12">
                        <label>Description / Notes</label>
                        <textarea name="description" class="form-control" rows="2" maxlength="500" placeholder="Optional — e.g. covers algebra and trigonometry MCQs..."></textarea>
                    </div>
                    <div class="col-12 pt-3 border-top">
                        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save mr-1"></i>Save Marking Rule</button>
                        <a href="/admin/marking-rule/index" class="btn btn-outline-secondary px-4 ml-1">Cancel</a>
                        <div asp-validation-summary="All" class="text-danger mt-3"></div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
