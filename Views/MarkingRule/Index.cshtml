@using ExamSystem.ViewModels.MarkingRule
@model MarkingRuleIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Marking Rules";
    ViewData["HeaderTitle"] = "Marking Rules";
}
@section Toolbar {
    <a href="/admin/marking-rule/create" class="btn btn-primary"><i class="fas fa-plus mr-1"></i>Add Rule</a>
}
<div class="card">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row mb-3 align-items-end">
            <div class="col-md-3 mb-2">
                <label for="subjectFilter" class="sr-only">Filter by subject</label>
                @{
                    var subjects = ViewBag.Subjects as System.Collections.IEnumerable;
                }
                <select name="subject_id" id="subjectFilter" class="form-control">
                    <option value="" selected="@(Model.Filter.subject_id == null)">All Subjects</option>
                    @if (subjects != null)
                    {
                        foreach (var s in System.Linq.Enumerable.Cast<dynamic>(subjects))
                        {
                            <option value="@s.id" selected="@(Model.Filter.subject_id == s.id)">@s.name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 mb-2">
                <label for="questionTypeFilter" class="sr-only">Filter by question type</label>
                <select name="question_type" id="questionTypeFilter" class="form-control">
                    <option value="" selected="@(Model.Filter.question_type == null)">All Types</option>
                    @{
                        var qt = ViewBag.QuestionTypes as System.Collections.IEnumerable;
                        if (qt != null)
                        {
                            foreach (var t in System.Linq.Enumerable.Cast<dynamic>(qt))
                            {
                                <option value="@t.id" selected="@(Model.Filter.question_type == t.id)">@t.name</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-1 mb-2">
                <label for="pageSize" class="sr-only">Page size</label>
                @Html.DropDownList("page_size", Model.PageSizeOptions, new { @class = "form-control", id = "pageSize", onchange = "$(this).closest('form').submit()" })
            </div>
            <div class="col-md-3 mb-2 text-right">
                <button class="btn btn-primary" type="submit" aria-label="Search"><i class="fas fa-search"></i></button>
                <a href="/admin/marking-rule/index" class="btn btn-outline-secondary" aria-label="Reset filters"><i class="fas fa-redo"></i></a>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Id</th><th>Subject</th><th>Question Type</th><th class="text-right">Marks/Q</th><th class="text-right">-ve Marks</th>
                        <th class="text-center">Min Qs</th><th class="text-center">Max Qs</th><th>Difficulty</th><th>Status</th>
                        <th class="text-center" style="width:120px">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Response.Data != null && Model.Response.Data.Any())
                    {
                        foreach (var r in Model.Response.Data)
                        {
                            <tr>
                                <td>@r.id</td><td>@r.subject_name</td><td>@r.question_type_name</td>
                                <td class="text-right font-weight-bold">@r.marks_per_question.ToString("0.##")</td>
                                <td class="text-right">@(r.negative_marks > 0 ? r.negative_marks.ToString("0.##") : "-")</td>
                                <td class="text-center">@r.min_questions</td><td class="text-center">@r.max_questions</td>
                                <td>@(r.difficulty == 1 ? "Easy" : r.difficulty == 2 ? "Medium" : "Hard")</td>
                                <td>@if (r.is_active) { <span class="badge badge-success">Active</span> } else { <span class="badge badge-danger">Inactive</span> }</td>
                                <td class="text-center">
                                    <a href="/admin/marking-rule/edit/@r.id?listingPageUrl=@Context.Request.Path@Context.Request.QueryString" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fas fa-edit"></i></a>
                                    <a href="/admin/marking-rule/delete/@r.id?page_number=@(Model.Filter.page_number)" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Delete this rule?')"><i class="fas fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-5">
                                <i class="fas fa-clipboard-check fa-3x mb-3 d-block text-muted"></i>
                                <p class="mb-2 font-weight-bold">No marking rules found</p>
                                <p class="mb-3 small">Add a marking rule to configure how questions are scored.</p>
                                <a href="/admin/marking-rule/create" class="btn btn-sm btn-primary"><i class="fas fa-plus mr-1"></i>Add Rule</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @Html.Partial("_PaginationPartial")
    </div>
</div>
