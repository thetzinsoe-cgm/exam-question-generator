@using ExamSystem.ViewModels.Subject
@model SubjectIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Subjects";
    ViewData["HeaderTitle"] = "Subject Management";
}
@section Toolbar {
    <a href="/admin/subject/create" class="btn btn-primary"><i class="fas fa-plus mr-1"></i>Add Subject</a>
}
<div class="card">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row mb-3">
            <div class="col-md-3"><input type="text" name="search" value="@Model.Filter.search" class="form-control" placeholder="Search name/code..." /></div>
            <div class="col-md-3">
                @{
                    var grades = ViewBag.Grades as System.Collections.IEnumerable;
                    var sel = new Microsoft.AspNetCore.Mvc.Rendering.SelectList(System.Linq.Enumerable.Cast<object>(grades ?? new object[0]), "id", "name");
                }
                <select name="grade_id" id="grade_id" class="form-control">
                    <option value="" selected="@(Model.Filter.grade_id == null)">All Grades</option>
                    @if (grades != null)
                    {
                        foreach (var g in System.Linq.Enumerable.Cast<dynamic>(grades))
                        {
                            <option value="@g.id" selected="@(Model.Filter.grade_id == g.id)">@g.name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">@Html.DropDownList("page_size", Model.PageSizeOptions, new { @class = "form-control", onchange = "$(this).closest('form').submit()" })</div>
            <div class="col-md-4 text-right">
                <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i></button>
                <a href="/admin/subject/index" class="btn btn-default"><i class="fas fa-redo"></i> Reset</a>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead><tr><th>Id</th><th>Code</th><th>Name</th><th>Grade</th><th>Total Marks</th><th>Pass Marks</th><th>Duration</th><th>Q#Count</th><th>Status</th><th class="text-center" style="width:160px">Action</th></tr></thead>
                <tbody>
                    @if (Model.Response.Data != null && Model.Response.Data.Any())
                    {
                        foreach (var s in Model.Response.Data)
                        {
                            <tr>
                                <td>@s.id</td><td><code>@s.code</code></td><td>@s.name</td>
                                <td>@s.grade_name</td>
                                <td>@s.total_marks</td><td>@s.pass_marks</td><td>@s.duration_minutes min</td>
                                <td><span class="badge badge-pill badge-info">@s.question_count</span></td>
                                <td>@if (s.is_active) { <span class="badge badge-success">Active</span> } else { <span class="badge badge-danger">Inactive</span> }</td>
                                <td class="text-center">
                                    <a href="/admin/subject/edit/@s.id?listingPageUrl=@Context.Request.Path@Context.Request.QueryString" class="btn btn-sm btn-primary"><i class="fas fa-edit"></i></a>
                                    <a href="/admin/subject/delete/@s.id?page_number=@(Model.Filter.page_number)" class="btn btn-sm btn-danger" onclick="return confirm('Delete this subject?')"><i class="fas fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    }
                    else { <tr><td colspan="10" class="text-center text-muted">No subjects found.</td></tr> }
                </tbody>
            </table>
        </div>
        @Html.Partial("_PaginationPartial")
    </div>
</div>
