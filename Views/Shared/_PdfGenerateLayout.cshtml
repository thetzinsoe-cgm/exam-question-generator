<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - ExamSystem Print</title>
    <style>
        @@page { size: A4; margin: 1.5cm; }
        body { font-family: Arial, sans-serif; font-size: 12pt; color: #111; }
        h1 { text-align: center; border-bottom: 2px solid #333; padding-bottom: 8px; }
        .meta { display: flex; justify-content: space-between; margin-bottom: 18px; }
        .q { margin-bottom: 16px; padding: 8px 0; border-bottom: 1px dashed #bbb; page-break-inside: avoid; }
        .qn { font-weight: bold; margin-right: 6px; }
        .opt { margin-left: 24px; margin-top: 4px; }
        table { border-collapse: collapse; width: 100%; margin: 6px 0; }
        td, th { border: 1px solid #999; padding: 6px; }
        img { max-width: 100%; height: auto; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
