@{
    Layout = "_Layout";
    ViewData["Title"] = "Privacy Policy";
}
<div class="mt-4">
    <h1>Privacy Policy</h1>
    <p class="text-muted">Last updated: @DateTime.Today.ToString("yyyy-MM-dd")</p>
    <div class="mt-4">
        <h3>1. Information We Collect</h3>
        <p>ExamSystem collects minimal personal information required for account authentication, access control, and audit logging. This may include usernames, email addresses, and role assignments.</p>

        <h3>2. Use of Information</h3>
        <p>Information collected is used solely to operate, maintain, and secure the ExamSystem platform, including:</p>
        <ul>
            <li>Authenticating users and authorizing access to system modules</li>
            <li>Generating and managing exams, questions, and marking rules</li>
            <li>Conducting security audits and preventing unauthorized access</li>
        </ul>

        <h3>3. Data Security</h3>
        <p>We implement industry-standard practices including hashed passwords (BCrypt), session tokens with expiry, HTTPS transport, and role-based access control to safeguard data.</p>

        <h3>4. Third-Party Services</h3>
        <p>ExamSystem does not share personal data with third parties unless legally required.</p>

        <h3>5. Contact</h3>
        <p>For privacy concerns, please contact your system administrator.</p>
    </div>
</div>
