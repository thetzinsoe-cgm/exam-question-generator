@{ Layout = "_AdminLayout"; ViewData["Title"] = "Update Password"; ViewData["HeaderTitle"] = "Update Password"; }

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-primary">
            <div class="card-header"><h3 class="card-title"><i class="fas fa-key mr-1"></i>Change Password</h3></div>
            <div class="card-body">
                <form asp-action="UpdatePassword" method="post">
                    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["token"]) && !string.IsNullOrWhiteSpace(Context.Request.Query["email"]))
                    {
                        <input type="hidden" name="reset_token" value="@Context.Request.Query["token"]" />
                        <input type="hidden" name="email" value="@Context.Request.Query["email"]" />
                    }
                    else
                    {
                        <div class="form-group">
                            <label>Current Password</label>
                            <input type="password" name="old_password" class="form-control" />
                        </div>
                    }
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>New Password *</label>
                            <input type="password" name="new_password" class="form-control" required minlength="6" />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Confirm Password *</label>
                            <input type="password" name="confirm_password" class="form-control" required minlength="6" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>Update Password</button>
                    <div asp-validation-summary="All" class="text-danger mt-3"></div>
                </form>
            </div>
        </div>
    </div>
</div>
