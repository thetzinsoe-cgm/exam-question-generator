@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Login — ExamSystem</title>
    <meta name="description" content="ExamSystem Admin - Secure staff portal login" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        :root {
            --g1: #667eea;
            --g2: #764ba2;
            --g3: #f093fb;
        }
        html { height: 100%; }
        body {
            background:
                radial-gradient(1200px 800px at 10% 0%, rgba(240,147,251,.25), transparent 60%),
                radial-gradient(1000px 700px at 90% 100%, rgba(102,126,234,.25), transparent 60%),
                linear-gradient(135deg, var(--g1) 0%, var(--g2) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            padding: 1.5rem 1rem;
        }
        .login-wrap { width: 100%; max-width: 440px; }
        .brand-card {
            background: rgba(255,255,255,.1);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 18px;
            padding: 1.75rem 1.5rem;
            margin-bottom: 1.25rem;
            text-align: center;
            color: #fff;
        }
        .brand-card .brand-emoji {
            width: 64px; height: 64px; border-radius: 18px;
            display: inline-flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #fff, #f0f4ff);
            font-size: 2rem; margin-bottom: .75rem;
            box-shadow: 0 8px 24px rgba(0,0,0,.12);
        }
        .brand-card h1 { margin: 0; font-size: 1.5rem; font-weight: 800; letter-spacing: -.01em; }
        .brand-card p  { margin: .35rem 0 0; opacity: .9; font-size: .9rem; }
        .card-login {
            border: none;
            border-radius: 18px;
            box-shadow: 0 20px 60px rgba(0,0,0,.25);
            overflow: hidden;
        }
        .card-login .card-body { padding: 1.75rem 1.5rem; }
        .login-title {
            font-size: 1.25rem; font-weight: 700; margin: 0 0 1.25rem;
            display: flex; align-items: center; gap: .5rem; color: #1a202c;
        }
        .login-title .dot { width:8px; height:8px; border-radius:50%; background: linear-gradient(90deg,var(--g1),var(--g2)); }
        .form-group label {
            font-size: .8rem; font-weight: 600; color: #4a5568;
            letter-spacing: .02em; text-transform: uppercase; margin-bottom: .4rem;
        }
        .input-group-text {
            background: #f7fafc; border-right: none; color: #a0aec0;
            min-width: 44px; justify-content: center;
        }
        .input-group .form-control {
            border-left: none; padding-left: .25rem;
            height: 44px;
        }
        .input-group-prepend .input-group-text {
            border-radius: .5rem 0 0 .5rem;
        }
        .input-group .form-control {
            border-radius: 0 .5rem .5rem 0;
        }
        .form-control:focus {
            border-color: var(--g1);
            box-shadow: 0 0 0 3px rgba(102,126,234,.15);
        }
        .btn-login {
            height: 46px;
            border: none;
            border-radius: .75rem;
            font-weight: 700;
            letter-spacing: .01em;
            background: linear-gradient(90deg, var(--g1) 0%, var(--g2) 60%, var(--g3) 100%);
            background-size: 200% 100%;
            transition: background-position .25s ease, transform .15s ease, box-shadow .25s ease;
            box-shadow: 0 8px 20px rgba(102,126,234,.35);
        }
        .btn-login:hover { background-position: 100% 0; transform: translateY(-1px); box-shadow: 0 12px 28px rgba(102,126,234,.45); }
        .btn-login:active { transform: translateY(0); }
        .forgot-row { margin: -.25rem 0 1rem; }
        .alt-link { color: #6b7280; font-size: .9rem; }
        .alt-link:hover { color: var(--g1); }
        .validation-box {
            margin-top: 1rem; font-size: .85rem; border-radius: .5rem;
        }
        @@media (max-width: 370px) {
            .login-wrap { max-width: 100%; }
            .card-login .card-body { padding: 1.25rem 1rem; }
        }
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="brand-card">
            <div class="brand-emoji" aria-hidden="true"><i class="fas fa-graduation-cap" style="background:linear-gradient(90deg,#667eea,#764ba2);-webkit-background-clip:text;-webkit-text-fill-color:transparent"></i></div>
            <h1>ExamSystem</h1>
            <p>Staff Administration Portal</p>
        </div>
        <div class="card card-login">
            <div class="card-body">
                <h2 class="login-title"><span class="dot"></span>Sign in to continue</h2>
                <form asp-action="Login" method="post" novalidate>
                    <div class="form-group">
                        <label for="username">Username</label>
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text" aria-hidden="true"><i class="fas fa-user"></i></span></div>
                            <input id="username" type="text" name="username" class="form-control" placeholder="e.g. superadmin" autocomplete="username" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text" aria-hidden="true"><i class="fas fa-lock"></i></span></div>
                            <input id="password" type="password" name="password" class="form-control" placeholder="Enter password" autocomplete="current-password" required />
                        </div>
                    </div>
                    <div class="form-row forgot-row">
                        <div class="col text-right">
                            <a class="alt-link" href="/admin/forgot-password">Forgot password?</a>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg btn-block btn-login">
                        <i class="fas fa-sign-in-alt mr-2"></i>Sign In
                    </button>
                    <div class="text-center mt-3">
                        <a class="alt-link" href="/admin/register">Create new account</a>
                    </div>
                    <div class="alert alert-danger validation-box d-none" id="valBox" asp-validation-summary="All" role="alert"></div>
                </form>
            </div>
        </div>
        <p class="text-center text-white-50 mt-4 mb-0 small">
            &copy; @DateTime.Now.Year ExamSystem. All rights reserved.
        </p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var vb = document.getElementById('valBox');
            if (vb && vb.textContent.trim().length > 0) vb.classList.remove('d-none');
        });
    </script>
</body>
</html>
